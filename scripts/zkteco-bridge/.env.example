# ZKTeco K60 Biometric Bridge Configuration
# Copy this file to .env on the school PC: copy .env.example .env

# Physical Device Network Settings
K60_IP=192.168.0.134
K60_PORT=4370
POLL_INTERVAL_MS=10000

# Cloud API Attendance Synchronization Settings
CLOUD_API_URL=https://school.domain/api/attendance/sync
BIOMETRIC_SYNC_SECRET=your_production_bridge_secret_here

# Safety Guard: Set to true when syncing to remote production cloud HTTPS endpoint
ALLOW_EXTERNAL_API=true
