datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  SUPER_ADMIN
  ADMIN
  TEACHER
  STAFF
  ACCOUNTANT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum EmployeeType {
  TEACHER
  STAFF
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

enum AttendanceStatus {
  PRESENT
  LATE
  ABSENT
  EXCUSED
  HOLIDAY
}

enum AttendanceSource {
  BIOMETRIC
  MANUAL
}

enum SmsType {
  ATTENDANCE_ENTRY
  ATTENDANCE_EXIT
  ATTENDANCE_ABSENT
  ATTENDANCE_LATE
  NOTICE
  BULK
  SYSTEM
}

enum SmsStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id        Int        @id @default(autoincrement())
  name      String     @db.VarChar(100)
  email     String     @unique @db.VarChar(100)
  phone     String?    @db.VarChar(30)
  password  String     @db.VarChar(255)
  role      Role       @default(STAFF)
  status    UserStatus @default(ACTIVE)
  avatar    String?    @db.VarChar(255)
  otp       String?    @default("0") @db.VarChar(10)
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt

  employee Employee?

  @@map("users")
}

model Session {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50) // e.g. "2023-2024", "2025", "2026"
  startDate DateTime?
  endDate   DateTime?
  isCurrent Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments StudentEnrollment[]

  @@map("sessions")
}

model Class {
  id           Int      @id @default(autoincrement())
  name         String   @unique @db.VarChar(50) // e.g. "Hate Khori", "Play", "Nursery", "KG", "One", "Two", "Three"
  numericValue Int?     // e.g. 0, 1, 2, 3
  order        Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  sections    Section[]
  enrollments StudentEnrollment[]

  @@map("classes")
}

model Shift {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50) // e.g. "Morning", "Day"
  startTime String?  @db.VarChar(20) // e.g. "08:00 AM"
  endTime   String?  @db.VarChar(20) // e.g. "12:30 PM"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments StudentEnrollment[]

  @@map("shifts")
}

model Section {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(50) // e.g. "Belly", "Kodom", "Togor", "Joba", "Padma", "Meghna"
  classId   Int?
  capacity  Int?     @default(40)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  class       Class?              @relation(fields: [classId], references: [id], onDelete: SetNull)
  enrollments StudentEnrollment[]

  @@map("sections")
}

model Group {
  id        Int      @id @default(autoincrement())
  name      String   @unique @db.VarChar(50) // e.g. "General", "Science", "Commerce", "Arts"
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  enrollments StudentEnrollment[]

  @@map("groups")
}

model Student {
  id                 Int       @id @default(autoincrement())
  studentCode        String    @unique @db.VarChar(50) // Legacy ID e.g. "101", "102" or "STU-2025-001"
  admissionNo        String?   @db.VarChar(50)
  admissionDate      DateTime  @default(now())
  nameEn             String    @db.VarChar(150)
  nameBn             String?   @db.VarChar(150)
  dob                DateTime?
  gender             Gender    @default(MALE)
  bloodGroup         String?   @db.VarChar(20)
  religion           String?   @db.VarChar(50)
  birthCertificateNo String?   @db.VarChar(50)
  photo              String?   @db.VarChar(255)
  biometricId        String?   @db.VarChar(50) // ID mapped in ZKTeco machine
  smsEnabled         Boolean   @default(true)
  status             String    @default("active") @db.VarChar(30) // active, unactive, passed_out
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt

  guardian    Guardian?
  enrollments StudentEnrollment[]
  attendances StudentAttendance[]

  @@map("students")
}

model Guardian {
  id               Int      @id @default(autoincrement())
  studentId        Int      @unique
  fatherName       String?  @db.VarChar(150)
  fatherNid        String?  @db.VarChar(50)
  fatherPhone      String?  @db.VarChar(30)
  motherName       String?  @db.VarChar(150)
  motherNid        String?  @db.VarChar(50)
  motherPhone      String?  @db.VarChar(30)
  guardianName     String?  @db.VarChar(150)
  guardianPhone    String?  @db.VarChar(30)
  guardianRelation String?  @db.VarChar(50)
  presentAddress   String?  @db.Text
  permanentAddress String?  @db.Text
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  student Student @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@map("guardians")
}

model StudentEnrollment {
  id             Int       @id @default(autoincrement())
  studentId      Int
  sessionId      Int
  classId        Int
  sectionId      Int?
  shiftId        Int
  groupId        Int?
  roll           String?   @db.VarChar(50)
  enrollmentDate DateTime  @default(now())
  status         String    @default("enrolled") @db.VarChar(30)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  student Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  session Session  @relation(fields: [sessionId], references: [id])
  class   Class    @relation(fields: [classId], references: [id])
  section Section? @relation(fields: [sectionId], references: [id], onDelete: SetNull)
  shift   Shift    @relation(fields: [shiftId], references: [id])
  group   Group?   @relation(fields: [groupId], references: [id], onDelete: SetNull)

  attendances StudentAttendance[]

  @@map("student_enrollments")
}

model Employee {
  id               Int          @id @default(autoincrement())
  employeeCode     String       @unique @db.VarChar(50) // e.g. "EMP-001"
  name             String       @db.VarChar(150)
  designation      String       @db.VarChar(100)
  type             EmployeeType @default(TEACHER)
  phone            String       @db.VarChar(30)
  email            String?      @db.VarChar(100)
  gender           Gender       @default(MALE)
  nid              String?      @db.VarChar(50)
  bloodGroup       String?      @db.VarChar(20)
  religion         String?      @db.VarChar(50)
  presentAddress   String?      @db.Text
  permanentAddress String?      @db.Text
  photo            String?      @db.VarChar(255)
  biometricId      String?      @db.VarChar(50) // ID mapped in ZKTeco machine
  smsEnabled       Boolean      @default(true)
  status           String       @default("active") @db.VarChar(30)
  userId           Int?         @unique
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  user        User?                @relation(fields: [userId], references: [id], onDelete: SetNull)
  attendances EmployeeAttendance[]

  @@map("employees")
}

model BiometricDevice {
  id         Int       @id @default(autoincrement())
  name       String    @db.VarChar(100) // e.g. "Main Gate K40"
  ipAddress  String    @db.VarChar(50) // e.g. "192.168.1.201"
  port       Int       @default(4370)
  secretKey  String    @db.VarChar(100) // Auth token for local agent
  status     String    @default("active") @db.VarChar(20)
  lastSyncAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  @@map("biometric_devices")
}

model AttendanceLog {
  id              Int      @id @default(autoincrement())
  biometricUserId String   @db.VarChar(50)
  punchTime       DateTime
  verifyMode      Int?     @default(1)
  rawPayload      String?  @db.Text
  processed       Boolean  @default(false)
  createdAt       DateTime @default(now())

  @@index([biometricUserId, punchTime])
  @@map("attendance_logs")
}

model StudentAttendance {
  id           Int              @id @default(autoincrement())
  studentId    Int
  enrollmentId Int
  date         DateTime         @db.Date
  inTime       DateTime?
  outTime      DateTime?
  status       AttendanceStatus @default(PRESENT)
  source       AttendanceSource @default(BIOMETRIC)
  remark       String?          @db.VarChar(255)
  smsSent      Boolean          @default(false)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  student    Student           @relation(fields: [studentId], references: [id], onDelete: Cascade)
  enrollment StudentEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)

  @@unique([enrollmentId, date])
  @@index([date, status])
  @@map("student_attendances")
}

model EmployeeAttendance {
  id         Int              @id @default(autoincrement())
  employeeId Int
  date       DateTime         @db.Date
  inTime     DateTime?
  outTime    DateTime?
  status     AttendanceStatus @default(PRESENT)
  source     AttendanceSource @default(BIOMETRIC)
  remark     String?          @db.VarChar(255)
  smsSent    Boolean          @default(false)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  employee Employee @relation(fields: [employeeId], references: [id], onDelete: Cascade)

  @@unique([employeeId, date])
  @@index([date, status])
  @@map("employee_attendances")
}

model SmsLog {
  id              Int       @id @default(autoincrement())
  recipientPhone  String    @db.VarChar(30)
  recipientName   String?   @db.VarChar(100)
  message         String    @db.Text
  type            SmsType   @default(NOTICE)
  status          SmsStatus @default(SENT)
  responsePayload String?   @db.Text
  sentAt          DateTime  @default(now())

  @@map("sms_logs")
}

model SmsSetting {
  id             Int      @id @default(autoincrement())
  provider       String   @default("GREENWEB") @db.VarChar(50)
  apiKey         String   @db.VarChar(255)
  senderId       String?  @db.VarChar(50)
  baseUrl        String   @default("http://api.greenweb.com.bd/api.php?json") @db.VarChar(255)
  autoEntrySms   Boolean  @default(true)
  autoExitSms    Boolean  @default(false)
  autoAbsentSms  Boolean  @default(false)
  entryTemplate  String?  @db.Text
  exitTemplate   String?  @db.Text
  absentTemplate String?  @db.Text
  updatedAt      DateTime @updatedAt

  @@map("sms_settings")
}
